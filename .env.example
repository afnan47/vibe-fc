# ==============================================================================
# Spotify API Credentials
# Obtain from: https://developer.spotify.com/dashboard
# ==============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id

# ==============================================================================
# Supabase Database Credentials
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================================================
# Hugging Face (Sharded Parquet Lake)
# Obtain from: https://huggingface.co/settings/tokens
# ==============================================================================
HF_TOKEN=hf_your_huggingface_token
HF_REPO_ID=username/your-dataset-repo  # e.g. weebnan/spotify_audio_features_partitioned

# ==============================================================================
# RapidAPI — Live Spotify Audio Features (Optional)
# Required only for tracks released in 2025/2026 not in the HF lake.
# Obtain from: https://rapidapi.com/search/spotify
# ==============================================================================
RAPIDAPI_KEY=your_rapidapi_key

# ==============================================================================
# RSS Feed Sources (comma-separated, used by the Daily Scout Crawler)
# ==============================================================================
RSS_FEEDS=https://www.reddit.com/r/listentothis/new/.rss,https://www.reddit.com/r/indieheads/new/.rss

# ==============================================================================
# Daily Scouter Configuration
# ==============================================================================
# Spotify New Music Friday playlist ID (default: official NMF)
SPOTIFY_NMF_PLAYLIST_ID=37i9dQZF1DX4JAvHpjipBk
# Pitchfork Best New Tracks RSS feed URL
PITCHFORK_RSS_URL=https://pitchfork.com/rss/reviews/best/tracks/
# SoundCloud API client_id (optional — auto-extracted from web if not set)
SOUNDCLOUD_CLIENT_ID=
