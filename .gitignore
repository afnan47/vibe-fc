# Frontend (Node / Vite)
# ==============================================================================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

